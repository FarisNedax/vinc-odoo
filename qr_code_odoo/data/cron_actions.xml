<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cron job to send scheduled lead-back emails -->
    <record id="ir_cron_send_scheduled_leadback_emails" model="ir.cron">
        <field name="name">Vinc: Send Scheduled Lead-Back Emails</field>
        <field name="model_id" ref="model_leadback_scheduled_email"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_scheduled_emails()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Scheduled action to send digest emails -->
    <record id="ir_cron_send_digest_emails" model="ir.cron">
        <field name="name">Vinc: Send vCard Digest Emails</field>
        <field name="model_id" ref="model_partner_vcard"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_digest_emails()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active">True</field>
    </record>


    <!-- Scheduled action to process follow-up reminder queue -->
    <record id="ir_cron_process_followup_reminders" model="ir.cron">
        <field name="name">Vinc: Process Follow-up Reminder Queue</field>
        <field name="model_id" ref="model_followup_scheduled_reminder"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_scheduled_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Scheduled action to process bulk onboarding batches -->
    <record id="ir_cron_process_bulk_onboarding" model="ir.cron">
        <field name="name">Vinc: Process Bulk Onboarding Batches</field>
        <field name="model_id" ref="model_bulk_onboarding_batch"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_pending_batches()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Enrich leads / downloads with IP-based geolocation asynchronously.
         The public /create_lead and /vcard/download handlers previously called
         two upstream geo providers inline, blocking the POST for up to 4s.
         Now they only record submission_ip; this cron fills in country, city
         and timezone in the background. -->
    <record id="ir_cron_enrich_lead_geolocation" model="ir.cron">
        <field name="name">Vinc: Enrich lead geolocation</field>
        <field name="model_id" ref="model_partner_vcard"/>
        <field name="state">code</field>
        <field name="code">model._cron_enrich_geolocation()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

</odoo>
