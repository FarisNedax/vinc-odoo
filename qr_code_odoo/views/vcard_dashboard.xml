<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kanban Dashboard View for vCards -->
    <record id="partner_vcard_kanban_view" model="ir.ui.view">
        <field name="name">partner.vcard.kanban.view</field>
        <field name="model">partner.vcard</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_dashboard" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="company_name"/>
                <field name="email"/>
                <field name="function"/>
                <field name="is_published"/>
                <field name="website_slug"/>
                <field name="qr_code" widget="image"/>
                <field name="image_url" widget="image"/>
                <field name="attachment_id"/>
                <field name="vcard_opportunity_count"/>
                <field name="vcard_email_contact_count"/>
                <field name="page_view_count"/>
                <field name="qr_code_scan_count"/>
                <field name="website_full_url"/>
                
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_image_fill_left" style="width: 120px; height: 120px; padding: 8px; background: #f8f9fa; border-radius: 8px;">
                                <img t-att-src="record.attachment_id.raw_value ? ('/web/image/ir.attachment/' + record.attachment_id.raw_value + '/datas') : ('/web/image/partner.vcard/' + record.id.raw_value + '/image_url')" 
                                     t-att-alt="record.name.value" 
                                     style="width: 100%; height: 100%; object-fit: cover; border-radius: 8px;"
                                     t-att-title="record.name.value"
                                     t-if="record.image_url.raw_value or record.attachment_id.raw_value"/>
                                <div t-if="!record.image_url.raw_value and !record.attachment_id.raw_value" style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: #6c757d;">
                                    <i class="fa fa-user-circle" title="User" style="font-size: 64px;"/>
                                </div>
                            </div>
                            <div class="oe_kanban_details" style="margin-left: 130px;">
                                <div class="o_kanban_record_top mb8">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                        <div class="o_kanban_record_subtitle">
                                            <field name="function" optional="show"/>
                                        </div>
                                        <div class="o_kanban_record_subtitle text-muted">
                                            <field name="company_name" optional="show"/>
                                        </div>
                                    </div>
                                    <div class="o_kanban_record_top_right">
                                        <span class="badge" t-attf-class="record.is_published.raw_value ? 'badge-success' : 'badge-warning'">
                                            <span t-if="record.is_published.raw_value">✓ Published</span>
                                            <span t-if="!record.is_published.raw_value">○ Unpublished</span>
                                        </span>
                                    </div>
                                </div>
                                
                                <div class="o_kanban_record_body mt8">
                                    <div class="row" style="margin: 0 -8px;">
                                        <div class="col-6 text-center" style="padding: 8px; border-right: 1px solid #e0e0e0;">
                                            <div style="font-size: 24px; font-weight: 600; color: #007bff; margin-bottom: 4px;">
                                                <field name="vcard_opportunity_count"/>
                                            </div>
                                            <small class="text-muted">Leads</small>
                                        </div>
                                        <div class="col-6 text-center" style="padding: 8px;">
                                            <div style="font-size: 24px; font-weight: 600; color: #28a745; margin-bottom: 4px;">
                                                <field name="page_view_count"/>
                                            </div>
                                            <small class="text-muted">Views</small>
                                        </div>
                                    </div>
                                    <div class="row mt-2" style="margin: 0 -8px;">
                                        <div class="col-6 text-center" style="padding: 8px; border-right: 1px solid #e0e0e0;">
                                            <div style="font-size: 24px; font-weight: 600; color: #ffc107; margin-bottom: 4px;">
                                                <field name="qr_code_scan_count"/>
                                            </div>
                                            <small class="text-muted">Scans</small>
                                        </div>
                                        <div class="col-6 text-center" style="padding: 8px;">
                                            <div style="font-size: 24px; font-weight: 600; color: #17a2b8; margin-bottom: 4px;">
                                                <field name="vcard_email_contact_count"/>
                                            </div>
                                            <small class="text-muted">Contacts</small>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="o_kanban_record_bottom mt8">
                                    <div class="oe_kanban_bottom_left">
                                        <a t-att-href="record.website_full_url.raw_value" 
                                           target="_blank" 
                                           class="btn btn-sm btn-primary" 
                                           role="button"
                                           t-if="record.website_full_url.raw_value">
                                            <i class="fa fa-globe me-1" title="View Card"/> View Card
                                        </a>
                                        <a t-att-href="'/vcard/qr_code/download/' + record.id.raw_value" 
                                           target="_blank" 
                                           class="btn btn-sm btn-secondary ms-2"
                                           role="button">
                                            <i class="fa fa-qrcode me-1" title="QR Code"/> QR Code
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
