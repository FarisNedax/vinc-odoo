<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        User Dashboard — Soft Editorial refresh.
        Visual polish via static/src/css/dashboard.css (Fraunces + DM Sans,
        navy/sand/blue). Data bindings and button actions are unchanged.
    -->
    <record id="view_user_dashboard" model="ir.ui.view">
        <field name="name">My Dashboard</field>
        <field name="model">user.dashboard</field>
        <field name="arch" type="xml">
            <form string="My Dashboard" create="0" delete="0" class="vg-dashboard-form">
                <header>
                    <button name="action_open_nfc_setup" string="NFC Setup Guide" type="object" class="btn-secondary"/>
                    <button name="action_open_vinculum_guide" string="User Guide" type="object" class="btn-secondary"/>
                </header>

                <div class="vg-dashboard">

                    <!-- ====== HERO ====== -->
                    <section class="vg-hero">
                        <div class="vg-hero-content">
                            <div style="flex: 1; min-width: 280px; position: relative; z-index: 1;">
                                <div class="vg-hero-eyebrow">Welcome back</div>
                                <h2>Hi, <field name="current_user_name" readonly="1" nolabel="1" class="d-inline"/>. <em>Here's</em> where you stand.</h2>
                                <p class="vg-hero-sub">
                                    <strong><field name="recent_leads_count" readonly="1" nolabel="1" class="d-inline"/></strong> new lead<span invisible="recent_leads_count == 1">s</span> this week across <strong><field name="total_vcards" readonly="1" nolabel="1" class="d-inline"/></strong> active <span invisible="total_vcards == 1">cards</span><span invisible="total_vcards != 1">card</span>.
                                </p>
                                <div class="vg-hero-actions">
                                    <button name="action_view_opportunities" type="object" class="vg-hero-btn is-primary">
                                        View leads <i class="fa fa-arrow-right" title="View leads"/>
                                    </button>
                                    <button name="action_view_vcards" type="object" class="vg-hero-btn is-ghost">
                                        View cards
                                    </button>
                                    <button name="action_create_new_card" type="object" class="vg-hero-btn is-ghost">
                                        <i class="fa fa-plus" title="Create new card"/> Create new card
                                    </button>
                                    <button name="action_view_bulk_onboarding" type="object" class="vg-hero-btn is-ghost"
                                            groups="base.group_system,base.group_erp_manager">
                                        <i class="fa fa-users" title="Bulk onboarding"/> Bulk onboarding
                                    </button>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- ====== KPI ROW ====== -->
                    <div class="vg-kpi-row">
                        <div class="vg-kpi">
                            <div class="vg-kpi-head">
                                <span class="vg-kpi-label">Total Cards</span>
                                <span class="vg-kpi-chip"><i class="fa fa-address-card" title="Total Cards"/></span>
                            </div>
                            <div class="vg-kpi-value"><field name="total_vcards" readonly="1" nolabel="1"/></div>
                            <div class="vg-kpi-foot">published</div>
                        </div>

                        <div class="vg-kpi">
                            <div class="vg-kpi-head">
                                <span class="vg-kpi-label">Total Leads</span>
                                <span class="vg-kpi-chip"><i class="fa fa-users" title="Total Leads"/></span>
                            </div>
                            <div class="vg-kpi-value"><field name="total_opportunities" readonly="1" nolabel="1"/></div>
                            <div class="vg-kpi-foot">all time</div>
                        </div>

                        <div class="vg-kpi">
                            <div class="vg-kpi-head">
                                <span class="vg-kpi-label">QR Scans</span>
                                <span class="vg-kpi-chip"><i class="fa fa-qrcode" title="QR Scans"/></span>
                            </div>
                            <div class="vg-kpi-value"><field name="total_qr_scans" readonly="1" nolabel="1"/></div>
                            <div class="vg-kpi-foot">all time</div>
                        </div>

                        <div class="vg-kpi">
                            <div class="vg-kpi-head">
                                <span class="vg-kpi-label">Card Views</span>
                                <span class="vg-kpi-chip"><i class="fa fa-eye" title="Card Views"/></span>
                            </div>
                            <div class="vg-kpi-value"><field name="total_page_views" readonly="1" nolabel="1"/></div>
                            <div class="vg-kpi-foot">all cards</div>
                        </div>
                    </div>

                    <!-- ====== DOWNLOAD ANALYTICS ====== -->
                    <section class="vg-section">
                        <div class="vg-section-head">
                            <h3 class="vg-section-title">Download Analytics</h3>
                        </div>

                        <div class="vg-stat-grid">
                            <div class="vg-stat">
                                <div class="vg-stat-label">Total Downloads</div>
                                <div class="vg-stat-value"><field name="total_vcard_downloads" readonly="1" nolabel="1"/></div>
                            </div>
                            <div class="vg-stat">
                                <div class="vg-stat-label">Recent (7 Days)</div>
                                <div class="vg-stat-value"><field name="recent_downloads_count" readonly="1" nolabel="1"/></div>
                            </div>
                        </div>

                        <div style="font-family: 'DM Sans', sans-serif; font-size: 10.5px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--vg-ink-faint); font-weight: 500; margin: 4px 0 10px;">Recent Downloads</div>
                        <div class="vg-scroll-max">
                            <field name="download_tracking_ids" nolabel="1" readonly="1">
                                <tree limit="20" decoration-muted="download_country == False" decoration-info="download_utm_source != False">
                                    <field name="download_date" widget="datetime"/>
                                    <field name="download_country" string="Country"/>
                                    <field name="download_city" string="City"/>
                                    <field name="download_device_type" string="Device"/>
                                    <field name="download_browser" string="Browser"/>
                                    <field name="download_utm_source" string="UTM Source"/>
                                </tree>
                            </field>
                        </div>
                    </section>

                    <!-- ====== LEAD ANALYTICS + RECENT ACTIVITY ====== -->
                    <div class="vg-row">
                        <section class="vg-section">
                            <div class="vg-section-head">
                                <h3 class="vg-section-title">Lead Analytics</h3>
                            </div>
                            <div class="vg-split">
                                <div class="vg-split-item">
                                    <div class="vg-split-label">This Month</div>
                                    <div class="vg-split-value"><field name="monthly_opportunities" readonly="1" nolabel="1"/></div>
                                    <div class="vg-split-delta is-positive">
                                        <field name="leads_mom_delta" readonly="1" nolabel="1" class="d-inline"/> vs last month
                                    </div>
                                </div>
                                <div class="vg-split-item">
                                    <div class="vg-split-label">Last 7 Days</div>
                                    <div class="vg-split-value"><field name="recent_leads_count" readonly="1" nolabel="1"/></div>
                                    <div class="vg-split-delta">new leads</div>
                                </div>
                            </div>
                        </section>

                        <section class="vg-section">
                            <div class="vg-section-head">
                                <h3 class="vg-section-title">Recent Activity</h3>
                                <button name="action_view_opportunities" type="object" class="vg-section-link">View all →</button>
                            </div>
                            <div class="vg-scroll-max">
                                <field name="recent_leads_ids" nolabel="1" invisible="1"/>
                                <div class="vg-activity-empty">
                                    <field name="recent_leads_count" readonly="1" nolabel="1" class="d-inline"/> new lead<span invisible="recent_leads_count == 1">s</span> in the last 7 days.
                                </div>
                            </div>
                        </section>
                    </div>
                </div>
            </form>
        </field>
    </record>

    <!-- Server Action to open dashboard (redirects to license if unlicensed) -->
    <record id="action_user_dashboard" model="ir.actions.server">
        <field name="name">My Dashboard</field>
        <field name="model_id" ref="model_user_dashboard"/>
        <field name="state">code</field>
        <field name="code">
result = env['user.dashboard'].get_dashboard()
if result._name == 'vinc.license':
    action = {
        'type': 'ir.actions.act_window',
        'name': 'Vinc License',
        'res_model': 'vinc.license',
        'view_mode': 'form',
        'res_id': result.id,
        'target': 'current',
        'views': [(env.ref('qr_code_odoo.vinc_license_form_view').id, 'form')],
    }
else:
    action = {
        'type': 'ir.actions.act_window',
        'name': 'My Dashboard',
        'res_model': 'user.dashboard',
        'view_mode': 'form',
        'view_id': env.ref('qr_code_odoo.view_user_dashboard').id,
        'res_id': result.id,
        'target': 'current',
        'flags': {'form': {'create': False, 'delete': False}},
    }
        </field>
    </record>
</odoo>
