<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Custom layout template for vCard pages without header and footer -->
    <template id="vcard_layout" name="vCard Layout">
        <html t-att-lang="request.env.lang and request.env.lang.replace('_', '-')">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <title><t t-esc="request.website.name or 'vCard'"/></title>
                <link rel="stylesheet" href="/web/static/lib/bootstrap/dist/css/bootstrap.css"/>
                <link rel="stylesheet" href="/web/static/lib/fontawesome/css/font-awesome.css"/>
                <!-- Fallback Font Awesome CDN -->
                <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
                <link rel="stylesheet" href="/website/static/src/css/website.css"/>
                <style>
                    body {
                        margin: 0;
                        padding: 0;
                        font-family: 'Poppins', sans-serif;
                    }
                    .o_wrap {
                        min-height: 100vh;
                        background: #f8f9fa;
                    }
                    .o_wrap_content {
                        padding: 0;
                    }
                    /* Fix z-index for intl-tel-input country dropdown to appear above modals */
                    .iti__country-list {
                        z-index: 9999 !important;
                    }
                    .intl-tel-input .iti__country-list {
                        z-index: 9999 !important;
                    }
                    /* Ensure it works inside modals */
                    .modal .iti__country-list {
                        z-index: 9999 !important;
                    }
                    .modal .intl-tel-input .iti__country-list {
                        z-index: 9999 !important;
                    }
                </style>
            </head>
            <body class="o_website_fullscreen" t-att-data-vinc-phone-country="(request.website.company_id.country_id.code or 'us').lower()">
                <!-- Main content area without header and footer -->
                <div class="o_wrap">
                    <div class="o_wrap_content">
                        <t t-out="0"/>
                    </div>
                </div>

                <!-- Texts used by widget.js; kept here so they are translated with the page -->
                <div id="vinc_i18n" class="d-none" aria-hidden="true">
                    <span data-key="submitting">Submitting...</span>
                    <span data-key="sending">Sending...</span>
                    <span data-key="error">An error occurred. Please try again.</span>
                    <span data-key="unknown_error">Unknown error occurred</span>
                    <span data-key="required">Please fill in all required fields.</span>
                    <span data-key="yes">Yes</span>
                    <span data-key="service_thanks">Thank you! Your service request has been sent. We'll be in touch shortly.</span>
                </div>
            </body>
        </html>
    </template>
</odoo>
