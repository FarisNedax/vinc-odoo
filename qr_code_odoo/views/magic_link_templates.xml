<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Magic-link recipient flow templates.
        All three share the .vg-magic scope styled in static/src/css/bulk_onboard.css:
        a single centred card on a white page, navy logo chip, editorial serif
        title, concrete action. No hero, no marketing fluff — these fire once
        in a user's lifetime and need to land them on Vinc as fast as possible.
    -->

    <template id="magic_link_error" name="Magic Link Error">
        <t t-call="website.layout">
        <t t-set="brand_name" t-value="request.env['ir.config_parameter'].sudo().get_param('qr_code_odoo.brand_name', 'Vinc')"/>
        <t t-set="brand_short_name" t-value="request.env['ir.config_parameter'].sudo().get_param('qr_code_odoo.brand_short_name', 'Vinc')"/>
            <div class="vg-magic">
                <div class="mg-card">
                    <div class="mg-icon-lg" data-tone="error" aria-hidden="true">!</div>
                    <div class="mg-eyebrow">Link problem</div>
                    <h1 class="mg-title">This link <em>isn't working</em>.</h1>
                    <p class="mg-sub">
                        <t t-esc="error or 'The activation link is invalid or has expired.'"/>
                    </p>
                    <p class="mg-sub" style="margin-top: -6px;">
                        Ask your administrator to resend your invitation, or reach out if the problem keeps happening.
                    </p>
                    <div class="mg-footer">
                        <a href="/">Back to home</a>
                        <span style="margin: 0 10px;">·</span>
                        <a href="https://getvinc.com/contact" target="_blank" rel="noopener">Contact support</a>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="magic_link_already_activated" name="Magic Link Already Activated">
        <t t-call="website.layout">
        <t t-set="brand_name" t-value="request.env['ir.config_parameter'].sudo().get_param('qr_code_odoo.brand_name', 'Vinc')"/>
        <t t-set="brand_short_name" t-value="request.env['ir.config_parameter'].sudo().get_param('qr_code_odoo.brand_short_name', 'Vinc')"/>
            <div class="vg-magic">
                <div class="mg-card">
                    <div class="mg-icon-lg" data-tone="success" aria-hidden="true">✓</div>
                    <div class="mg-eyebrow">Already activated</div>
                    <h1 class="mg-title">Your account is <em>ready</em>.</h1>
                    <p class="mg-sub">
                        This invitation has already been used. You can sign in with the password you set last time.
                    </p>
                    <a t-att-href="login_url or '/web/login'" class="bk-btn bk-btn-primary" style="width: 100%; justify-content: center;">
                        <span>Go to sign in</span>
                        <span aria-hidden="true">→</span>
                    </a>
                    <div class="mg-footer">
                        Forgot your password? <a href="/web/reset_password">Reset it here</a>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="magic_link_activation" name="Magic Link Activation">
        <t t-call="website.layout">
        <t t-set="brand_name" t-value="request.env['ir.config_parameter'].sudo().get_param('qr_code_odoo.brand_name', 'Vinc')"/>
        <t t-set="brand_short_name" t-value="request.env['ir.config_parameter'].sudo().get_param('qr_code_odoo.brand_short_name', 'Vinc')"/>
            <div class="vg-magic">
                <div class="mg-card">
                    <div class="mg-logo" aria-hidden="true"><img src="/qr_code_odoo/brand/icon" alt="Logo" style="max-width:100%;max-height:100%;object-fit:contain;"/></div>
                    <div class="mg-eyebrow">You're invited to <t t-out="brand_name"/></div>
                    <h1 class="mg-title">Set your <em>password</em>.</h1>
                    <p class="mg-sub">
                        <t t-if="user_name">Welcome <strong t-esc="user_name"/>. </t>
                        Choose a password for <strong t-esc="email or ''"/> and we'll take you to your card.
                    </p>

                    <t t-if="error">
                        <div class="bk-alert" data-tone="error" role="alert" style="margin-bottom: 18px;">
                            <span t-esc="error"/>
                        </div>
                    </t>

                    <form class="mg-form" action="/bulk-onboard/activate/submit" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="token" t-att-value="token"/>

                        <div class="mg-field">
                            <label class="mg-label" for="mg-password">New password</label>
                            <input class="mg-input" type="password" id="mg-password" name="password"
                                   required="required" minlength="8" autocomplete="new-password"
                                   placeholder="At least 8 characters"/>
                            <p class="mg-hint">Minimum 8 characters. Use something memorable but not obvious.</p>
                        </div>

                        <div class="mg-field">
                            <label class="mg-label" for="mg-password-confirm">Confirm password</label>
                            <input class="mg-input" type="password" id="mg-password-confirm" name="password_confirm"
                                   required="required" minlength="8" autocomplete="new-password"
                                   placeholder="Type it again"/>
                        </div>

                        <button type="submit" class="mg-submit">
                            Activate &amp; continue →
                        </button>
                    </form>

                    <div class="mg-footer">
                        Trouble activating? <a href="https://getvinc.com/contact" target="_blank" rel="noopener">Contact support</a>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
