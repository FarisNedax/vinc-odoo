<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Partner Reviews List View -->
    <record id="view_partner_reviews_list" model="ir.ui.view">
        <field name="name">partner.vcard.reviews.list</field>
        <field name="model">partner.vcard.reviews</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list string="Reviews">
                <field name="sequence" widget="handle"/>
                <field name="reviewer_name"/>
                <field name="rating"/>
                <field name="review_text" widget="text" options="{'no_marker': True}"/>
                <field name="is_published" widget="boolean_toggle"/>
                <field name="partner_id" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Partner Reviews Form View -->
    <record id="view_partner_reviews_form" model="ir.ui.view">
        <field name="name">partner.vcard.reviews.form</field>
        <field name="model">partner.vcard.reviews</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Review">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="is_published" widget="boolean_button" options="{'terminology': 'archive'}"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="reviewer_name" placeholder="Reviewer Name (Optional)"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" options="{'no_create': True}"/>
                            <field name="rating" widget="radio" options="{'horizontal': true}"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="is_published" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group>
                        <field name="review_text" nolabel="1" placeholder="Enter the review text here..." widget="html"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Partner Reviews Search View -->
    <record id="view_partner_reviews_search" model="ir.ui.view">
        <field name="name">partner.vcard.reviews.search</field>
        <field name="model">partner.vcard.reviews</field>
        <field name="type">search</field>
        <field name="arch" type="xml">
            <search string="Search Reviews">
                <field name="reviewer_name"/>
                <field name="partner_id"/>
                <field name="rating"/>
                <field name="review_text"/>
                <separator/>
                <filter string="Published" name="published" domain="[('is_published', '=', True)]"/>
                <filter string="Unpublished" name="unpublished" domain="[('is_published', '=', False)]"/>
                <separator/>
                <filter string="5 Stars" name="five_stars" domain="[('rating', '=', '5')]"/>
                <filter string="4 Stars" name="four_stars" domain="[('rating', '=', '4')]"/>
                <filter string="3 Stars" name="three_stars" domain="[('rating', '=', '3')]"/>
                <filter string="2 Stars" name="two_stars" domain="[('rating', '=', '2')]"/>
                <filter string="1 Star" name="one_star" domain="[('rating', '=', '1')]"/>
                <group>
                    <filter string="Partner" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Rating" name="group_rating" context="{'group_by': 'rating'}"/>
                    <filter string="Published" name="group_published" context="{'group_by': 'is_published'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Partner Reviews Action -->
    <record id="action_partner_reviews" model="ir.actions.act_window">
        <field name="name">Reviews</field>
        <field name="res_model">partner.vcard.reviews</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_partner_reviews_search"/>
        <field name="context">{'search_default_published': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first review!
            </p>
            <p>
                Reviews help build trust and credibility for your vCard.
            </p>
        </field>
    </record>

    <!-- Reviews tab is now directly in partner_view.xml, no inheritance needed -->
</odoo>
