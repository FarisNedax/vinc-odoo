<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Vinc module category (shows up in Settings > Users > Groups) -->
        <record id="module_category_vinc" model="ir.module.category">
            <field name="name">Vinc</field>
            <field name="description">Vinc digital business cards, leads and onboarding.</field>
            <field name="sequence">30</field>
        </record>

        <!--
            Vinc Manager — bypass-all-isolation role for trusted administrators.
            Regular internal users (base.group_user) only see records where
            create_uid == their own uid (see security/vinc_record_rules.xml).
            Members of Vinc Manager see every card, lead, tracking and
            bulk-onboarding record on the instance.
        -->
        <record id="res_groups_privilege_vinc" model="res.groups.privilege">
            <field name="name">Vinc</field>
            <field name="sequence">30</field>
            <field name="category_id" ref="module_category_vinc"/>
        </record>

        <record id="group_vinc_manager" model="res.groups">
            <field name="name">Vinc Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_vinc"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Sees and manages every Vinc card, lead, review and tracking record on the instance. Grant only to trusted administrators.</field>
        </record>

        <!-- Odoo system administrators implicitly get Vinc Manager rights. -->
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('qr_code_odoo.group_vinc_manager'))]"/>
        </record>

    </data>
</odoo>
