"                        </div>\n"
"                        \n"
"                        <div style=\"margin: 30px 0; text-align: center;\">\n"
"                            <a href=\"%24%7Bctx.get('lead_url',%20'#')%7Csafe%7D\" style=\"display: inline-block; background-color: #457eb8; color: white; padding: 12px 30px; text-decoration: none; border-radius: 5px; font-weight: bold; font-size: 16px;\">\n"
"                                Pogledaj potencijal u CRM-u\n"
"                            </a>\n"
"                        </div>\n"
"                        \n"
"                        <div style=\"margin-top: 30px; padding-top: 20px; border-top: 1px solid #ddd; font-size: 14px; color: #999;\">\n"
"                            <p style=\"margin: 5px 0;\">Ovaj potencijal je poslan preko vaše digitalne vizitke: <a href=\"%24%7Bctx.get('vcard_url',%20'#')%7Csafe%7D\" style=\"color: #457eb8;\">${ctx.get('vcard_url', 'View vCard')|safe}</a></p>\n"
"                            <p style=\"margin: 5px 0;\">Obavijesti o potencijalima možete podesiti u postavkama vizitke.</p>\n"
"                        </div>\n"
"                    </div>\n"
"                </div>\n"
"            "

#. module: qr_code_odoo
#: model:mail.template,body_html:qr_code_odoo.email_template_digest
msgid ""
"<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px; background-color: #ffffff;\">\n"
"                <!-- Header -->\n"
"                <div style=\"text-align: center; padding: 20px 0; border-bottom: 2px solid #e0e0e0;\">\n"
"                    <h1 style=\"margin: 0; color: #333; font-size: 24px;\">📊 Your vCard Digest</h1>\n"
"                    <p style=\"margin: 10px 0 0 0; color: #666; font-size: 14px;\">${ctx.get('period_display', 'This Week')}</p>\n"
"                </div>\n"
"\n"
"                <!-- Stats Overview -->\n"
"                <div style=\"padding: 30px 0;\">\n"
"                    <h2 style=\"color: #333; font-size: 20px; margin: 0 0 20px 0;\">📈 Quick Stats</h2>\n"
"                    \n"
"                    <!-- Leads Section -->\n"
"                    <div style=\"background: #f8f9fa; padding: 20px; border-radius: 8px; margin-bottom: 20px;\">\n"
"                        <h3 style=\"color: #333; font-size: 18px; margin: 0 0 15px 0;\">🎯 Leads Captured</h3>\n"
"                        <div style=\"display: flex; justify-content: space-between; margin-bottom: 10px;\">\n"
"                            <span style=\"color: #666;\">New Leads:</span>\n"
"                            <strong style=\"color: #007bff; font-size: 18px;\">${ctx.get('stats', {}).get('new_leads_count', 0)}</strong>\n"
"                        </div>\n"
"                        <div style=\"display: flex; justify-content: space-between; margin-bottom: 10px;\">\n"
"                            <span style=\"color: #666;\">Total Leads:</span>\n"
"                            <strong style=\"color: #333; font-size: 18px;\">${ctx.get('stats', {}).get('total_leads_count', 0)}</strong>\n"
"                        </div>\n"
"                        <div style=\"display: flex; justify-content: space-between;\">\n"
"                            <span style=\"color: #666;\">Without Follow-up:</span>\n"
"                            <strong style=\"color: #dc3545; font-size: 18px;\">${ctx.get('stats', {}).get('leads_without_followup_count', 0)}</strong>\n"
"                        </div>\n"
"                    </div>\n"
"\n"
"                    <!-- Follow-ups Section -->\n"
"                    <div style=\"background: #fff3cd; padding: 20px; border-radius: 8px; margin-bottom: 20px; border-left: 4px solid #ffc107;\">\n"
"                        <h3 style=\"color: #333; font-size: 18px; margin: 0 0 15px 0;\">⏰ Follow-up Reminders</h3>\n"
"                        <p style=\"margin: 0 0 10px 0; color: #666;\">\n"
"                            <strong style=\"color: #dc3545; font-size: 18px;\">${ctx.get('stats', {}).get('due_followups_count', 0)}</strong> \n"
"                            <span style=\"color: #666;\">due or overdue</span>\n"
"                        </p>\n"
"                        % if ctx.get('stats', {}).get('due_followups'):\n"
"                            <ul style=\"margin: 10px 0 0 0; padding-left: 20px; color: #666;\">\n"
"                                % for followup in ctx.get('stats', {}).get('due_followups', [])[:5]:\n"
"                                    <li style=\"margin-bottom: 5px;\">\n"
"                                        <strong>${followup.get('lead_name', 'Lead')}</strong> - \n"
"                                        ${followup.get('activity_summary', 'Follow-up')}\n"
"                                        % if followup.get('overdue'):\n"
"                                            <span style=\"color: #dc3545;\">(Overdue)</span>\n"
"                                        % endif\n"
"                                    </li>\n"
"                                % endfor\n"
"                            </ul>\n"
"                            % if len(ctx.get('stats', {}).get('due_followups', [])) &gt; 5:\n"
"                                <p style=\"margin: 10px 0 0 0; color: #666; font-size: 12px;\">\n"
"                                    ... and ${len(ctx.get('stats', {}).get('due_followups', [])) - 5} more\n"
"                                </p>\n"
"                            % endif\n"
"                        % else:\n"
"                            <p style=\"margin: 10px 0 0 0; color: #28a745;\">✓ All caught up! No follow-ups due.</p>\n"
"                        % endif\n"
"                    </div>\n"
"\n"
"                    <!-- Usage Section -->\n"
"                    <div style=\"background: #f8f9fa; padding: 20px; border-radius: 8px; margin-bottom: 20px;\">\n"
"                        <h3 style=\"color: #333; font-size: 18px; margin: 0 0 15px 0;\">📱 Usage Stats</h3>\n"
"                        <div style=\"display: flex; justify-content: space-between; margin-bottom: 10px;\">\n"
"                            <span style=\"color: #666;\">Profile Views:</span>\n"
"                            <strong style=\"color: #333; font-size: 18px;\">${ctx.get('stats', {}).get('page_views', 0)}</strong>\n"
"                        </div>\n"
"                        <div style=\"display: flex; justify-content: space-between;\">\n"
"                            <span style=\"color: #666;\">QR Scans:</span>\n"
"                            <strong style=\"color: #333; font-size: 18px;\">${ctx.get('stats', {}).get('scans_count', 0)}</strong>\n"
"                        </div>\n"
"                    </div>\n"
"                </div>\n"
"\n"
"                <!-- CTA Section -->\n"
"                <div style=\"text-align: center; padding: 30px 0; border-top: 2px solid #e0e0e0;\">\n"
"                    <a href=\"%24%7Bctx.get('vcard_url',%20'#')%7D\" style=\"display: inline-block; background-color: #007bff; color: #ffffff; padding: 12px 30px; text-decoration: none; border-radius: 5px; font-weight: bold; font-size: 16px;\">\n"
"                        View Your vCard →\n"
"                    </a>\n"
"                    <p style=\"margin: 20px 0 0 0; color: #666; font-size: 12px;\">\n"
"                        <a href=\"%24%7Bctx.get('base_url',%20'')%7D/web#id=%24%7Bobject.id%7D&amp;model=partner.vcard&amp;view_type=form&amp;active_id=%24%7Bobject.id%7D\" style=\"color: #007bff; text-decoration: none;\">Manage Digest Settings</a>\n"
"                    </p>\n"
"                </div>\n"
"\n"
"                <!-- Footer -->\n"
"                <div style=\"text-align: center; padding: 20px 0; border-top: 1px solid #e0e0e0; color: #999; font-size: 12px;\">\n"
"                    <p style=\"margin: 0;\">This is an automated digest email from ${object.env['ir.config_parameter'].sudo().get_param('qr_code_odoo.brand_name', 'Vinc')}.</p>\n"
"                    <p style=\"margin: 5px 0 0 0;\">You can change your digest preferences in your vCard settings.</p>\n"
"                </div>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px; background-color: #ffffff;\">\n"
"                <!-- Header -->\n"
"                <div style=\"text-align: center; padding: 20px 0; border-bottom: 2px solid #e0e0e0;\">\n"
"                    <h1 style=\"margin: 0; color: #333; font-size: 24px;\">📊 Pregled aktivnosti vaše vizitke</h1>\n"
"                    <p style=\"margin: 10px 0 0 0; color: #666; font-size: 14px;\">${ctx.get('period_display', 'This Week')}</p>\n"
"                </div>\n"
"\n"
"                <!-- Stats Overview -->\n"
"                <div style=\"padding: 30px 0;\">\n"
"                    <h2 style=\"color: #333; font-size: 20px; margin: 0 0 20px 0;\">📈 Brza statistika</h2>\n"
"                    \n"
"                    <!-- Leads Section -->\n"
"                    <div style=\"background: #f8f9fa; padding: 20px; border-radius: 8px; margin-bottom: 20px;\">\n"
"                        <h3 style=\"color: #333; font-size: 18px; margin: 0 0 15px 0;\">🎯 Prikupljeni potencijali</h3>\n"
"                        <div style=\"display: flex; justify-content: space-between; margin-bottom: 10px;\">\n"
"                            <span style=\"color: #666;\">Novi potencijali:</span>\n"
"                            <strong style=\"color: #007bff; font-size: 18px;\">${ctx.get('stats', {}).get('new_leads_count', 0)}</strong>\n"
"                        </div>\n"
"                        <div style=\"display: flex; justify-content: space-between; margin-bottom: 10px;\">\n"
"                            <span style=\"color: #666;\">Ukupno potencijala:</span>\n"
"                            <strong style=\"color: #333; font-size: 18px;\">${ctx.get('stats', {}).get('total_leads_count', 0)}</strong>\n"
"                        </div>\n"
"                        <div style=\"display: flex; justify-content: space-between;\">\n"
"                            <span style=\"color: #666;\">Bez praćenja:</span>\n"
"                            <strong style=\"color: #dc3545; font-size: 18px;\">${ctx.get('stats', {}).get('leads_without_followup_count', 0)}</strong>\n"
"                        </div>\n"
"                    </div>\n"
"\n"
"                    <!-- Follow-ups Section -->\n"
"                    <div style=\"background: #fff3cd; padding: 20px; border-radius: 8px; margin-bottom: 20px; border-left: 4px solid #ffc107;\">\n"
"                        <h3 style=\"color: #333; font-size: 18px; margin: 0 0 15px 0;\">⏰ Podsjetnici za praćenje</h3>\n"
"                        <p style=\"margin: 0 0 10px 0; color: #666;\">\n"
"                            <strong style=\"color: #dc3545; font-size: 18px;\">${ctx.get('stats', {}).get('due_followups_count', 0)}</strong> \n"
"                            <span style=\"color: #666;\">dospijeva ili kasni</span>\n"
"                        </p>\n"
"                        % if ctx.get('stats', {}).get('due_followups'):\n"
"                            <ul style=\"margin: 10px 0 0 0; padding-left: 20px; color: #666;\">\n"
"                                % for followup in ctx.get('stats', {}).get('due_followups', [])[:5]:\n"
"                                    <li style=\"margin-bottom: 5px;\">\n"
"                                        <strong>${followup.get('lead_name', 'Lead')}</strong> - \n"
"                                        ${followup.get('activity_summary', 'Follow-up')}\n"
"                                        % if followup.get('overdue'):\n"
"                                            <span style=\"color: #dc3545;\">(Kasni)</span>\n"
"                                        % endif\n"
"                                    </li>\n"
"                                % endfor\n"
"                            </ul>\n"
"                            % if len(ctx.get('stats', {}).get('due_followups', [])) &gt; 5:\n"
"                                <p style=\"margin: 10px 0 0 0; color: #666; font-size: 12px;\">\n"
"                                    ... i još ${len(ctx.get('stats', {}).get('due_followups', [])) - 5}\n"
"                                </p>\n"
"                            % endif\n"
"                        % else:\n"
"                            <p style=\"margin: 10px 0 0 0; color: #28a745;\">✓ Sve je riješeno! Nema praćenja koja dospijevaju.</p>\n"
"                        % endif\n"
"                    </div>\n"
"\n"
"                    <!-- Usage Section -->\n"
"                    <div style=\"background: #f8f9fa; padding: 20px; border-radius: 8px; margin-bottom: 20px;\">\n"
"                        <h3 style=\"color: #333; font-size: 18px; margin: 0 0 15px 0;\">📱 Statistika korištenja</h3>\n"
"                        <div style=\"display: flex; justify-content: space-between; margin-bottom: 10px;\">\n"
"                            <span style=\"color: #666;\">Pregledi profila:</span>\n"
"                            <strong style=\"color: #333; font-size: 18px;\">${ctx.get('stats', {}).get('page_views', 0)}</strong>\n"
"                        </div>\n"
"                        <div style=\"display: flex; justify-content: space-between;\">\n"
"                            <span style=\"color: #666;\">QR skeniranja:</span>\n"
"                            <strong style=\"color: #333; font-size: 18px;\">${ctx.get('stats', {}).get('scans_count', 0)}</strong>\n"
"                        </div>\n"
"                    </div>\n"
"                </div>\n"
"\n"
"                <!-- CTA Section -->\n"
"                <div style=\"text-align: center; padding: 30px 0; border-top: 2px solid #e0e0e0;\">\n"
"                    <a href=\"%24%7Bctx.get('vcard_url',%20'#')%7D\" style=\"display: inline-block; background-color: #007bff; color: #ffffff; padding: 12px 30px; text-decoration: none; border-radius: 5px; font-weight: bold; font-size: 16px;\">\n"
"                        Pogledaj svoju vizitku →\n"
"                    </a>\n"
"                    <p style=\"margin: 20px 0 0 0; color: #666; font-size: 12px;\">\n"
"                        <a href=\"%24%7Bctx.get('base_url',%20'')%7D/web#id=%24%7Bobject.id%7D&amp;model=partner.vcard&amp;view_type=form&amp;active_id=%24%7Bobject.id%7D\" style=\"color: #007bff; text-decoration: none;\">Postavke pregleda aktivnosti</a>\n"
"                    </p>\n"
"                </div>\n"
"\n"
"                <!-- Footer -->\n"
"                <div style=\"text-align: center; padding: 20px 0; border-top: 1px solid #e0e0e0; color: #999; font-size: 12px;\">\n"
"                    <p style=\"margin: 0;\">Ovo je automatski e-mail s pregledom aktivnosti od ${object.env['ir.config_parameter'].sudo().get_param('qr_code_odoo.brand_name', 'Vinc')}.</p>\n"
"                    <p style=\"margin: 5px 0 0 0;\">Postavke pregleda aktivnosti možete promijeniti u postavkama vizitke.</p>\n"
"                </div>\n"
"            </div>\n"
"        "

