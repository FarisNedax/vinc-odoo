#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinc_license_form_view
msgid ""
"<strong style=\"font-size: 17px;\">Vinc requires a license to operate.</strong><br/>\n"
"                    <span invisible=\"license_status != 'not_activated'\">\n"
"                        Enter your license key below and click <strong>Activate License</strong> to get started.<br/>\n"
"                        Don't have a key? Scroll down to request one by email.\n"
"                    </span>\n"
"                    <span invisible=\"license_status != 'failed'\">\n"
"                        Your previous activation attempt failed. Check the key and try again,<br/>\n"
"                        or contact your reseller for assistance.\n"
"                    </span>\n"
"                    <span invisible=\"license_status != 'degraded'\">\n"
"                        License validation has failed for over 60 days. The module is in read-only mode.<br/>\n"
"                        Click <strong>Re-validate Now</strong> or contact your reseller.\n"
"                    </span>\n"
"                    <span invisible=\"license_status != 'suspended'\">\n"
"                        This license has been <strong>suspended</strong> by the administrator.<br/>\n"
"                        All module functionality is blocked. Contact your reseller or Vinc support.\n"
"                    </span>\n"
"                    <span invisible=\"license_status != 'revoked'\">\n"
"                        This license has been <strong>revoked</strong>.<br/>\n"
"                        Click <strong>Change License Key</strong> to enter a new key, or contact your reseller.\n"
"                    </span>"
msgstr ""
"<strong style=\"font-size: 17px;\">Vinc zahtijeva licencu za rad.</strong><br/>\n"
"                    <span invisible=\"license_status != 'not_activated'\">\n"
"                        Unesite ključ licence ispod i kliknite <strong>Aktiviraj licencu</strong> da započnete.<br/>\n"
"                        Nemate ključ? Skrolujte dolje da ga zatražite e-mailom.\n"
"                    </span>\n"
"                    <span invisible=\"license_status != 'failed'\">\n"
"                        Prethodni pokušaj aktivacije nije uspio. Provjerite ključ i pokušajte ponovo,<br/>\n"
"                        ili se obratite svom preprodavaču za pomoć.\n"
"                    </span>\n"
"                    <span invisible=\"license_status != 'degraded'\">\n"
"                        Provjera licence ne uspijeva duže od 60 dana. Modul je u režimu samo za čitanje.<br/>\n"
"                        Kliknite <strong>Ponovo provjeri sada</strong> ili se obratite svom preprodavaču.\n"
"                    </span>\n"
"                    <span invisible=\"license_status != 'suspended'\">\n"
"                        Administrator je <strong>suspendovao</strong> ovu licencu.<br/>\n"
"                        Sve funkcije modula su blokirane. Obratite se svom preprodavaču ili Vinc podršci.\n"
"                    </span>\n"
"                    <span invisible=\"license_status != 'revoked'\">\n"
"                        Ova licenca je <strong>opozvana</strong>.<br/>\n"
"                        Kliknite <strong>Promijeni ključ licence</strong> da unesete novi ključ ili se obratite svom preprodavaču.\n"
"                    </span>"

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_crm
msgid "<strong><code>contact_name</code>, <code>email_from</code>, <code>phone</code></strong> — straight from the form"
msgstr "<strong><code>contact_name</code>, <code>email_from</code>, <code>phone</code></strong> — direktno iz obrasca"

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_crm
msgid "<strong><code>description</code></strong> — the visitor's notes, if your form's notes field is enabled"
msgstr "<strong><code>description</code></strong> — bilješke posjetioca, ako je polje za bilješke na vašem obrascu uključeno"

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_crm
msgid "<strong><code>name</code></strong> — derived from the cardholder + visitor (e.g., \"Lead from Jane's card — John Smith\")"
msgstr "<strong><code>name</code></strong> — izvedeno iz vlasnika vizitke i posjetioca (npr. \"Potencijal s Janine vizitke — John Smith\")"

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_crm
msgid "<strong><code>partner_vcard_id</code></strong> —"
msgstr "<strong><code>partner_vcard_id</code></strong> —"

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_crm
msgid "<strong><code>tag_ids</code></strong> — the lead tags configured on the card at capture time"
msgstr "<strong><code>tag_ids</code></strong> — oznake potencijala podešene na vizitki u trenutku prikupljanja"

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_crm
msgid "<strong><code>type</code></strong> = <code>opportunity</code>"
msgstr "<strong><code>type</code></strong> = <code>opportunity</code>"

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_bulk_onboard
msgid "<strong>Address:</strong> <code>street</code>, <code>street2</code>, <code>city</code>, <code>zip</code>, <code>country</code>, <code>state</code>"
msgstr "<strong>Adresa:</strong> <code>street</code>, <code>street2</code>, <code>city</code>, <code>zip</code>, <code>country</code>, <code>state</code>"

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.partner_vcard_form_view
msgid "<strong>Advanced Features:</strong>"
msgstr "<strong>Napredne funkcije:</strong>"

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_branding
msgid "<strong>App-store listing</strong> (the <code>static/description/index.html</code> rendered on apps.odoo.com) — that's the marketing page for the public Vinc product, not a per-tenant surface."
msgstr "<strong>Oglas u prodavnici aplikacija</strong> (<code>static/description/index.html</code> prikazan na apps.odoo.com) — to je marketinška stranica javnog Vinc proizvoda, a ne dio pojedinačnog klijenta."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_setup_card
msgid "<strong>Banner image.</strong> Wide aspect (3:1 or wider), 1200px+ across. This is the band behind your name. A muted brand background tends to outperform busy stock photography."
msgstr "<strong>Slika bannera.</strong> Širok format (3:1 ili širi), 1200px+ u širinu. To je traka iza vašeg imena. Prigušena pozadina u bojama brenda obično djeluje bolje od prenatrpanih stock fotografija."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.bulk_onboarding_batch_view
msgid ""
"<strong>Batch started.</strong>\n"
"                            <span>Invitations are being sent in the background — refresh in a minute to see delivery status.</span>"
msgstr ""
"<strong>Paket je pokrenut.</strong>\n"
"                            <span>Pozivnice se šalju u pozadini — osvježite za minutu da vidite status isporuke.</span>"

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinc_license_form_view
msgid "<strong>Bought from a Vinc reseller?</strong> Ask your reseller for your license key."
msgstr "<strong>Kupili ste od Vinc preprodavača?</strong> Zatražite ključ licence od svog preprodavača."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinc_license_form_view
msgid "<strong>Bought from the Odoo App Store?</strong> Enter your email below and we'll send you a key:"
msgstr "<strong>Kupili ste u Odoo App Store?</strong> Unesite svoj e-mail ispod i poslaćemo vam ključ:"

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_branding
msgid "<strong>Brand Icon</strong> — square logo (~512×512 PNG). Used for chips, favicons, the Apps grid tile, and the default QR-code center overlay."
msgstr "<strong>Ikona brenda</strong> — kvadratni logo (~512×512 PNG). Koristi se za značke, favicone, pločicu u mreži aplikacija i zadani prekrivni logo u sredini QR koda."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_branding
msgid "<strong>Brand Name</strong> — full product name, used in prose. Default: \"Vinc\"."
msgstr "<strong>Naziv brenda</strong> — puni naziv proizvoda, koristi se u tekstu. Zadano: \"Vinc\"."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_branding
msgid "<strong>Brand Wordmark</strong> — horizontal logo for page headers and email banners. Falls back to the icon if blank."
msgstr "<strong>Logotip brenda</strong> — horizontalni logo za zaglavlja stranica i bannere e-mailova. Ako je prazno, koristi se ikona."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_share_card
msgid "<strong>Calendly intake page</strong> — link your card from \"About me\""
msgstr "<strong>Calendly stranica za prijem</strong> — povežite svoju vizitku iz \"O meni\""

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_automations
msgid "<strong>Channels</strong>: pick any combination of <strong>WhatsApp</strong>, <strong>Viber</strong>, <strong>Telegram</strong>. WhatsApp is auto-selected when you flip the master toggle on (so you don't trip the \"pick a channel\" validator immediately)."
msgstr "<strong>Kanali</strong>: odaberite bilo koju kombinaciju <strong>WhatsApp</strong>, <strong>Viber</strong>, <strong>Telegram</strong>. WhatsApp se automatski odabire kada uključite glavni prekidač (da odmah ne dobijete grešku \"odaberite kanal\")."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_automations
msgid "<strong>Chat Message Template</strong>: a plain-text body with the same placeholder syntax used in intro emails — <code>{contact_name}</code>, <code>{vcard_url}</code>, <code>{booking_url}</code>, conditional <code>{if field}…{/if}</code> blocks, and fallback <code>{placeholder|default}</code>."
msgstr "<strong>Šablon chat poruke</strong>: običan tekst s istom sintaksom zamjenskih oznaka kao u uvodnim e-mailovima — <code>{contact_name}</code>, <code>{vcard_url}</code>, <code>{booking_url}</code>, uslovni blokovi <code>{if field}…{/if}</code> i rezervne vrijednosti <code>{placeholder|default}</code>."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_crm
msgid "<strong>City</strong> on customer addresses — much sharper than country alone."
msgstr "<strong>Grad</strong> na adresama kupaca — mnogo precizniji od same države."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_setup_card
msgid "<strong>Classic</strong> — photo-forward, traditional vCard feel. Best for people-first cards (consultants, agents, founders)."
msgstr "<strong>Classic</strong> — fotografija u prvom planu, tradicionalni izgled vizitke. Najbolje za vizitke usmjerene na osobu (konsultanti, agenti, osnivači)."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_crm
msgid "<strong>Companies pool</strong>: active companies in <code>res.partner</code>, excluding pure suppliers (<code>supplier_rank &gt; 0</code> with <code>customer_rank == 0</code>). The lead's own partner is excluded. Capped at 2,000."
msgstr "<strong>Skup kompanija</strong>: aktivne kompanije u <code>res.partner</code>, bez čistih dobavljača (<code>supplier_rank &gt; 0</code> uz <code>customer_rank == 0</code>). Vlastiti partner potencijala je isključen. Ograničeno na 2.000."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.partner_vcard_form_view
msgid "<strong>Conditionals:</strong> Use <code>{if booking_url}Book here: {booking_url}{/if}</code> to show content only if booking_url exists"
msgstr "<strong>Uslovi:</strong> Koristite <code>{if booking_url}Book here: {booking_url}{/if}</code> da prikažete sadržaj samo ako booking_url postoji"

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.partner_vcard_form_view
msgid "<strong>Contact Information:</strong>"
msgstr "<strong>Kontakt podaci:</strong>"

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_setup_card
msgid "<strong>Corporate</strong> — banner-led, company-forward. Best for cards where the brand outweighs the individual."
msgstr "<strong>Corporate</strong> — banner u prvom planu, naglasak na kompaniji. Najbolje za vizitke gdje je brend važniji od pojedinca."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_setup_card
msgid "<strong>Creative</strong> — color-led, photography-heavy. For brands with strong visual identity (designers, agencies, hospitality)."
msgstr "<strong>Creative</strong> — vođen bojama, s puno fotografija. Za brendove s jakim vizuelnim identitetom (dizajneri, agencije, ugostiteljstvo)."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_crm
msgid "<strong>Deal-size bucket</strong> (weight: 20) — <code>expected_revenue</code> bucketed into <em>micro</em> (&lt;$10k), <em>small</em> ($10–50k), <em>mid</em> ($50–200k), <em>large</em> ($200k+). Same bucket = full 20; adjacent bucket = 10. For company candidates, the bucket is derived from their highest historical <code>expected_revenue</code> in CRM."
msgstr "<strong>Kategorija veličine posla</strong> (težina: 20) — <code>expected_revenue</code> razvrstan u <em>mikro</em> (&lt;$10k), <em>mali</em> ($10–50k), <em>srednji</em> ($50–200k), <em>veliki</em> ($200k+). Ista kategorija = punih 20; susjedna kategorija = 10. Za kompanije kandidate, kategorija se izvodi iz njihovog najvećeg historijskog <code>expected_revenue</code> u CRM-u."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_crm
msgid "<strong>Dependency:</strong> the <code>event_crm</code> module (Odoo Community, free) is a hard dependency of"
msgstr "<strong>Zavisnost:</strong> modul <code>event_crm</code> (Odoo Community, besplatan) je obavezna zavisnost modula"

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_crm
msgid "<strong>Description Jaccard</strong> (weight: 5, capped) — token overlap between the lead's <code>description</code> and the candidate's notes. Small weight; mostly a tiebreaker / serendipity signal."
msgstr "<strong>Jaccard opisa</strong> (težina: 5, ograničeno) — preklapanje riječi između <code>description</code> potencijala i bilješki kandidata. Mala težina; uglavnom za razrješenje neriješenog / signal slučajnog otkrića."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_nfc
msgid "<strong>Direct-write (avoid):</strong> the card stores the contact data directly as a vCard payload. The phone shows \"Save contact?\" without opening a page. Sounds smooth, but: no analytics, no lead form, no updates after the card is printed. You're stuck."
msgstr "<strong>Direktan upis (izbjegavajte):</strong> vizitka direktno sadrži kontakt podatke kao vCard sadržaj. Telefon prikaže \"Sačuvati kontakt?\" bez otvaranja stranice. Zvuči jednostavno, ali: nema analitike, nema obrasca za potencijale, nema izmjena nakon što je vizitka odštampana. Zaglavili ste."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_bulk_onboard
msgid "<strong>Duplicate email within the upload</strong> —"
msgstr "<strong>Dupli e-mail unutar učitavanja</strong> —"

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_bulk_onboard
msgid "<strong>Duplicate slug</strong> — two rows resolved to the same <code>website_slug</code>. Fix one or supply explicit slugs."
msgstr "<strong>Dupla URL oznaka</strong> — dva reda imaju istu <code>website_slug</code>. Ispravite jedan ili navedite URL oznake ručno."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_branding
msgid "<strong>Email subjects and bodies</strong> — bulk-onboarding \"your card is ready\" email, weekly digest footer. Each email reads the brand from <code>ir.config_parameter</code> at send time, so a brand change applied today retroactively rebrands tomorrow's emails without resending."
msgstr "<strong>Naslovi i sadržaj e-mailova</strong> — e-mail masovnog uključivanja \"vaša vizitka je spremna\", podnožje sedmičnog pregleda aktivnosti. Svaki e-mail čita brend iz <code>ir.config_parameter</code> u trenutku slanja, pa promjena brenda danas mijenja i sutrašnje e-mailove bez ponovnog slanja."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_branding
msgid "<strong>Email template <em>names</em></strong> in <em>Settings → Technical → Email Templates</em> — they still show as <code>Vinc — Digest Email</code> etc. because admins use those names to find templates. The bodies rebrand; the labels don't."
msgstr "<strong><em>Nazivi</em> šablona e-maila</strong> u <em>Settings → Technical → Email Templates</em> — i dalje se prikazuju kao <code>Vinc — Digest Email</code> itd. jer administratori po tim nazivima pronalaze šablone. Sadržaj se mijenja; nazivi ne."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_setup_card
msgid "<strong>Email.</strong> Tap-to-mail."
msgstr "<strong>E-mail.</strong> Dodirnite za slanje e-maila."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.partner_vcard_form_view
msgid "<strong>Fallbacks:</strong> Use <code>{contact_name|there}</code> to show \"there\" if contact_name is empty"
msgstr "<strong>Rezervne vrijednosti:</strong> Koristite <code>{contact_name|there}</code> da prikažete \"there\" ako je contact_name prazno"

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_setup_card
msgid "<strong>Fig. 1</strong>Branding inputs on the card setup form — profile, banner, primary + secondary color."
msgstr "<strong>Sl. 1</strong>Unos brendiranja na obrascu za postavljanje vizitke — profil, banner, primarna + sekundarna boja."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_setup_card
msgid "<strong>Fig. 2</strong>The five templates shipped with"
msgstr "<strong>Sl. 2</strong>Pet šablona koji dolaze uz"

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_lead_capture
msgid "<strong>Fig. 3</strong>A captured lead's Submission Tracking tab — IP, location, device, browser, OS."
msgstr "<strong>Sl. 3</strong>Kartica Praćenje slanja za prikupljeni potencijal — IP, lokacija, uređaj, preglednik, OS."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_automations
msgid "<strong>Fig. 4</strong>Settings → Technical → Email Templates, filtered to <code>Vinc</code>."
msgstr "<strong>Sl. 4</strong>Settings → Technical → Email Templates, filtrirano na <code>Vinc</code>."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.partner_vcard_form_view
msgid "<strong>Follow-up Reminders:</strong> Leads with due or overdue follow-up activities"
msgstr "<strong>Podsjetnici za praćenje:</strong> Potencijali s dospjelim ili zakašnjelim aktivnostima praćenja"

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_crm
msgid "<strong>Follow-up triage</strong> — who picks this up next"
msgstr "<strong>Trijaža praćenja</strong> — ko sljedeći preuzima"

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_crm
msgid "<strong>Geographic gradient</strong> (weight: 25) — same city = full 25; same state = 15; same country = 8. Closer geography weighs more, no all-or-nothing penalty."
msgstr "<strong>Geografska gradacija</strong> (težina: 25) — isti grad = punih 25; isti entitet/kanton = 15; ista država = 8. Bliža lokacija nosi više, bez kazne sve-ili-ništa."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.nfc_onboarding_page
msgid "<strong>Hold the card flat to the back of the phone</strong>"
msgstr "<strong>Držite vizitku ravno uz poleđinu telefona</strong>"

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_reviews
msgid "<strong>In Odoo backend</strong> — under the Reviews menu, filterable by rating and card."
msgstr "<strong>U Odoo pozadini</strong> — u meniju Utisci, s filterom po ocjeni i vizitki."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_reviews
msgid "<strong>In your weekly digest email</strong> — see"
msgstr "<strong>U vašem sedmičnom e-mailu s pregledom aktivnosti</strong> — pogledajte"

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_crm
msgid "<strong>Industry hierarchy</strong> (weight: 35) — exact match on <code>industry_id</code> gets the full 35; sibling-industry match (same parent in the <code>res.partner.industry</code> tree) gets 17. So \"SaaS\" and \"IT Services\" still match because both sit under \"Software\"."
msgstr "<strong>Hijerarhija djelatnosti</strong> (težina: 35) — tačno podudaranje na <code>industry_id</code> dobija punih 35; podudaranje srodne djelatnosti (isti roditelj u stablu <code>res.partner.industry</code>) dobija 17. Tako se \"SaaS\" i \"IT usluge\" i dalje podudaraju jer su obje pod \"Softver\"."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_crm
msgid "<strong>Industry</strong> on customer companies — the heaviest signal. Set <code>industry_id</code> on the partner record."
msgstr "<strong>Djelatnost</strong> na kompanijama kupaca — najjači signal. Postavite <code>industry_id</code> na zapisu partnera."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_share_card
msgid "<strong>Instagram / TikTok bio</strong> — replace your linktree"
msgstr "<strong>Instagram / TikTok bio</strong> — zamijenite svoj linktree"

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_crm
msgid "<strong>Intent qualification</strong> — what the visitor was after"
msgstr "<strong>Kvalifikacija namjere</strong> — šta je posjetilac tražio"

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_lead_capture
msgid "<strong>Intent tags</strong> — <code>demo-requested</code>, <code>info-only</code>, <code>partner-inquiry</code>"
msgstr "<strong>Oznake namjere</strong> — <code>demo-requested</code>, <code>info-only</code>, <code>partner-inquiry</code>"

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_bulk_onboard
msgid "<strong>Invalid email</strong> — failed format validation. Fix or remove."
msgstr "<strong>Neispravan e-mail</strong> — nije prošao provjeru formata. Ispravite ili uklonite."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_lead_capture
msgid "<strong>Lead button label:</strong> verb + outcome. \"Get my pricing\" beats \"Submit\". \"See a demo\" beats \"Contact us\"."
msgstr "<strong>Natpis dugmeta za potencijal:</strong> glagol + ishod. \"Pošalji mi cijene\" je bolje od \"Pošalji\". \"Pogledaj demo\" je bolje od \"Kontaktirajte nas\"."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.partner_vcard_form_view
msgid "<strong>Leads Captured:</strong> New leads, total leads, and leads without follow-up"
msgstr "<strong>Prikupljeni potencijali:</strong> Novi potencijali, ukupno potencijala i potencijali bez praćenja"

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_share_card
msgid "<strong>LinkedIn \"Featured\" section</strong> — pin it as a featured link"
msgstr "<strong>LinkedIn odjeljak \"Featured\"</strong> — zakačite je kao istaknuti link"

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.partner_vcard_form_view
msgid "<strong>Links:</strong>"
msgstr "<strong>Linkovi:</strong>"

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_automations
msgid "<strong>Message Delay</strong>: how long to wait before the messaging links appear (immediate / 1 min / 5 min / 15 min / 1 hour / custom)."
msgstr "<strong>Kašnjenje poruke</strong>: koliko čekati prije nego se pojave linkovi za poruke (odmah / 1 min / 5 min / 15 min / 1 sat / prilagođeno)."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_setup_card
msgid "<strong>Minimal</strong> — pared down to name, role, and contact methods. For cards going on densely-printed materials where the QR carries most of the design."
msgstr "<strong>Minimal</strong> — svedeno na ime, funkciju i načine kontakta. Za vizitke na gusto štampanim materijalima gdje QR nosi većinu dizajna."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_setup_card
msgid "<strong>Mobile.</strong> Tap-to-call works on phones — most card scans happen on phones."
msgstr "<strong>Mobilni.</strong> Dodir za poziv radi na telefonima — većina skeniranja vizitki dešava se na telefonima."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_setup_card
msgid "<strong>Modern</strong> (default) — balanced layout with banner, profile photo, and prominent lead CTA. The safe pick if you're unsure."
msgstr "<strong>Modern</strong> (zadano) — uravnotežen raspored s bannerom, profilnom fotografijom i istaknutim pozivom na akciju za potencijale. Siguran izbor ako niste sigurni."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_setup_card
msgid "<strong>Name, role, company.</strong> Always shown."
msgstr "<strong>Ime, funkcija, kompanija.</strong> Uvijek prikazano."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_bulk_onboard
msgid "<strong>No Odoo user found for &lt;email&gt;</strong> — the email doesn't match any <code>res.users.login</code>. Add the user under <em>Settings → Users &amp; Companies → Users</em> first, then re-upload."
msgstr "<strong>Nije pronađen Odoo korisnik za &lt;email&gt;</strong> — e-mail se ne podudara ni s jednim <code>res.users.login</code>. Prvo dodajte korisnika u <em>Settings → Users &amp; Companies → Users</em>, zatim ponovo učitajte."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_crm
msgid "<strong>No booth-level tagging.</strong> Odoo's <code>event_booth</code> module supports \"which booth at the show\" — easy to layer on if anyone asks."
msgstr "<strong>Nema označavanja po štandu.</strong> Odoo modul <code>event_booth</code> podržava \"koji štand na sajmu\" — lako se doda ako neko zatraži."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_crm
msgid "<strong>No enrichment.</strong> Works on the data already in your database. Doesn't call Apollo, Clearbit, ZoomInfo or anyone else. Privacy posture is unchanged."
msgstr "<strong>Nema obogaćivanja podataka.</strong> Radi s podacima koji su već u vašoj bazi. Ne poziva Apollo, Clearbit, ZoomInfo niti bilo koga drugog. Privatnost ostaje nepromijenjena."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_crm
msgid "<strong>No event registration is created.</strong> An earlier version did this so the prospect appeared on the event's official attendee list, but every <code>event.registration</code> triggers Odoo's \"thanks for registering\" email plus any pre-scheduled day-of reminders — meaning a single scan spammed the prospect with up to 10 emails about an event they never knowingly signed up for. The lead-side <code>event_id</code> is enough for the reporting; if a rep wants the prospect on the official attendee list, it's two clicks to add them manually from CRM."
msgstr "<strong>Ne kreira se registracija na događaj.</strong> Ranija verzija je to radila kako bi se potencijalni klijent pojavio na zvaničnoj listi učesnika, ali svaka <code>event.registration</code> pokreće Odoo e-mail \"hvala na registraciji\" plus sve unaprijed zakazane podsjetnike na dan događaja — što znači da je jedno skeniranje zasulo potencijalnog klijenta s do 10 e-mailova o događaju na koji se nije svjesno prijavio. <code>event_id</code> na potencijalu je dovoljan za izvještavanje; ako prodavač želi potencijalnog klijenta na zvaničnoj listi učesnika, to su dva klika da ga ručno doda iz CRM-a."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_crm
msgid "<strong>No historical reprocessing.</strong> Matches are computed live each time a lead is opened. Adding industry to a customer today benefits every lead opened tomorrow."
msgstr "<strong>Nema naknadne obrade starih podataka.</strong> Podudaranja se računaju uživo svaki put kada se potencijal otvori. Dodavanje djelatnosti kupcu danas koristi svakom potencijalu otvorenom sutra."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_crm
msgid "<strong>No multi-currency normalization.</strong> Deal-size buckets use the lead's expected_revenue value as-is. Mixed-currency tenants will see noisier matches until we add per-company normalization in a future pass."
msgstr "<strong>Nema normalizacije više valuta.</strong> Kategorije veličine posla koriste vrijednost expected_revenue potencijala kakva jeste. Korisnici s više valuta vidjeće manje precizna podudaranja dok u nekoj budućoj verziji ne dodamo normalizaciju po kompaniji."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_crm
msgid "<strong>No write-back.</strong> Read-only suggestion surface."
msgstr "<strong>Nema upisa nazad.</strong> Prijedlozi su samo za čitanje."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_crm
msgid "<strong>Notes</strong> in <code>comment</code> (partner) or <code>description</code> (lead). Even one sentence per record makes the snippet card useful."
msgstr "<strong>Bilješke</strong> u <code>comment</code> (partner) ili <code>description</code> (potencijal). Čak i jedna rečenica po zapisu čini karticu s isječkom korisnom."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_reviews
msgid "<strong>On your published card</strong> — in the reviews block, ordered most-recent-first."
msgstr "<strong>Na vašoj objavljenoj vizitki</strong> — u bloku utisaka, poredano od najnovijeg."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_crm
msgid "<strong>One active event per card.</strong> The rep has to manually clear the field after the show. We may add a daily cron later that nulls it the day after <code>event.date_end</code> — for now it's manual."
msgstr "<strong>Jedan aktivan događaj po vizitki.</strong> Prodavač mora ručno očistiti polje nakon sajma. Kasnije možda dodamo dnevni cron koji ga briše dan nakon <code>event.date_end</code> — za sada je ručno."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_setup_card
msgid "<strong>One or two social links.</strong> LinkedIn for B2B, Instagram for B2C, Calendly if you want bookings. Pick the two people will actually click."
msgstr "<strong>Jedan ili dva društvena linka.</strong> LinkedIn za B2B, Instagram za B2C, Calendly ako želite zakazivanja. Odaberite dva na koja će ljudi zaista kliknuti."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_setup_card
msgid "<strong>One website.</strong> Your company URL. Not five."
msgstr "<strong>Jedna web stranica.</strong> URL vaše kompanije. Ne pet."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.nfc_onboarding_page
msgid "<strong>Open NFC Tools</strong>"
msgstr "<strong>Otvorite NFC Tools</strong>"

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_crm
msgid "<strong>Open-leads pool</strong>: opportunities (<code>type='opportunity'</code>) not yet won (<code>probability &lt; 100</code>) and not lost (<code>probability &gt; 0</code>). The current lead is excluded once saved. Capped at 2,000."
msgstr "<strong>Skup otvorenih potencijala</strong>: prilike (<code>type='opportunity'</code>) koje još nisu dobijene (<code>probability &lt; 100</code>) i nisu izgubljene (<code>probability &gt; 0</code>). Trenutni potencijal je isključen nakon što se sačuva. Ograničeno na 2.000."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_crm
msgid "<strong>Outcome</strong> — for companies: their best-deal label (Won / Lost / Active), amount, close date, owner. Lost reason if present. For open leads: stage, amount, owner."
msgstr "<strong>Ishod</strong> — za kompanije: oznaka njihovog najboljeg posla (Dobijeno / Izgubljeno / Aktivno), iznos, datum zatvaranja, vlasnik. Razlog gubitka ako postoji. Za otvorene potencijale: faza, iznos, vlasnik."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_lead_capture
msgid "<strong>Owner tags</strong> — <code>jane-territory</code>, <code>enterprise-team</code>"
msgstr "<strong>Oznake vlasnika</strong> — <code>jane-territory</code>, <code>enterprise-team</code>"

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_setup_card
msgid "<strong>Profile photo.</strong> Square, at least 400×400px. Faces convert dramatically better than logos for individual cards — use a real headshot."
msgstr "<strong>Profilna fotografija.</strong> Kvadratna, najmanje 400×400px. Lica daju znatno bolje rezultate od logotipa na ličnim vizitkama — koristite pravu portretnu fotografiju."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_bulk_onboard
msgid "<strong>Profile:</strong> <code>phone</code>, <code>mobile</code>, <code>function</code> (job title), <code>about</code>"
msgstr "<strong>Profil:</strong> <code>phone</code>, <code>mobile</code>, <code>function</code> (radno mjesto), <code>about</code>"

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_branding
msgid "<strong>Public vCard pages</strong> — magic-link onboarding, NFC setup wizard, vCard form headers, the Vinculum Guide top bar — all read the brand name at render time."
msgstr "<strong>Javne vCard stranice</strong> — uključivanje putem magičnog linka, čarobnjak za NFC, zaglavlja vCard obrazaca, gornja traka Vinculum vodiča — sve čitaju naziv brenda u trenutku prikaza."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_branding
msgid "<strong>QR code center overlay</strong> — when a card hasn't uploaded its own QR logo, the overlay defaults to your Brand Icon."
msgstr "<strong>Prekrivni logo u sredini QR koda</strong> — kada vizitka nema učitan vlastiti QR logo, koristi se vaša ikona brenda."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_setup_card
msgid "<strong>QR logo overlay.</strong> Optional. A small mark inside your QR code; useful when the QR is printed alongside other brands."
msgstr "<strong>Prekrivni logo na QR kodu.</strong> Neobavezno. Mali znak unutar vašeg QR koda; korisno kada se QR štampa uz druge brendove."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_bulk_onboard
msgid "<strong>Read first:</strong> bulk onboarding now requires every email in your CSV to <em>already exist</em> as an Odoo user (under <em>Settings → Users &amp; Companies → Users</em>). The upload no longer creates user accounts, no longer sends magic-link activation emails, and no longer asks the recipient to set a password."
msgstr "<strong>Prvo pročitajte:</strong> masovno uključivanje sada zahtijeva da svaki e-mail u vašem CSV-u <em>već postoji</em> kao Odoo korisnik (u <em>Settings → Users &amp; Companies → Users</em>). Učitavanje više ne kreira korisničke račune, ne šalje e-mailove za aktivaciju putem magičnog linka i ne traži od primaoca da postavi lozinku."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_bulk_onboard
msgid "<strong>Required:</strong> <code>name</code>, <code>email</code> (must match an existing Odoo user's login)"
msgstr "<strong>Obavezno:</strong> <code>name</code>, <code>email</code> (mora se podudarati s prijavom postojećeg Odoo korisnika)"

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_bulk_onboard
msgid "<strong>Review &amp; map</strong> — confirm column mappings; fix typos in row data inline. If you see unmatched-email rows in the banner, either remove them from the CSV, or first create those users in <em>Settings → Users &amp; Companies → Users</em> and re-upload."
msgstr "<strong>Pregled &amp; mapiranje</strong> — potvrdite mapiranje kolona; ispravite greške u podacima reda direktno. Ako u banneru vidite redove s nepronađenim e-mailom, uklonite ih iz CSV-a ili prvo kreirajte te korisnike u <em>Settings → Users &amp; Companies → Users</em> i ponovo učitajte."

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.vinculum_guide_share_card
msgid "<strong>SMS / WhatsApp:</strong> \"Here's my card: <code>yoursite.com/jane-doe</code>\""
msgstr "<strong>SMS / WhatsApp:</strong> \"Evo moje vizitke: <code>yoursite.com/jane-doe</code>\""

#. module: qr_code_odoo
#: model_terms:ir.ui.view,arch_db:qr_code_odoo.partner_vcard_form_view
msgid ""
"<strong>Schedule Type:</strong><br/>\n"
"                                                        • <strong>After Lead Creation:</strong> Schedule based on delay from when the lead is created<br/>\n"
"                                                        • <strong>After Previous Activity Completed:</strong> Schedule based on delay from when the previous reminder's activity is marked as done<br/><br/>\n"
"                                                        <strong>Example:</strong> If delay is \"3 Days\" and schedule type is \"After Lead Creation\", the activity will be scheduled 3 days after the lead is created."
msgstr ""
"<strong>Vrsta zakazivanja:</strong><br/>\n"
